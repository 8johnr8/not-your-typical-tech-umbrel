{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:pinDigests"
  ],
  "timezone": "Europe/Brussels",
  "enabledManagers": [
    "docker-compose",
    "github-actions"
  ],
  "automerge": true,
  "automergeType": "branch",
  "platformAutomerge": true,
  "minimumReleaseAge": "3 days",
  "internalChecksFilter": "strict",
  "commitMessagePrefix": "chore(deps):",
  "packageRules": [
    {
      "description": "Keep the PostgreSQL major in the pgvector tag suffix (-pg18) fixed",
      "matchPackageNames": [
        "pgvector/pgvector"
      ],
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-(?<compatibility>pg\\d+)$"
    },
    {
      "description": "itzg images also carry old date tags like 20190901; only follow the current YYYY.M.P releases",
      "matchPackageNames": [
        "itzg/minecraft-server",
        "itzg/minecraft-bedrock-server"
      ],
      "allowedVersions": "/^\\d{4}\\.\\d+\\.\\d+$/"
    }
  ]
}
